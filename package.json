{
  "name": "mcp-osx",
  "version": "0.1.0",
  "mcpName": "io.github.zaosoula/mcp-osx",
  "description": "MCP server that lets AI agents control macOS: 81 safe named actions across 19 apps, user-approved AppleScript/JXA, reusable workflows, and app dictionary discovery.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macos",
    "applescript",
    "jxa",
    "osascript",
    "automation",
    "claude",
    "ai-agents"
  ],
  "author": "Zao Soula",
  "license": "MIT",
  "homepage": "https://github.com/zaosoula/mcp-osx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaosoula/mcp-osx.git"
  },
  "bugs": {
    "url": "https://github.com/zaosoula/mcp-osx/issues"
  },
  "type": "module",
  "bin": {
    "mcp-osx": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "vitest run",
    "test:dist": "node scripts/smoke-dist.mjs",
    "docs": "npm run build && node scripts/gen-tools-doc.mjs",
    "prepublishOnly": "node -e \"if(!process.env.GITHUB_ACTIONS){console.error('\\n\\nERROR: Local publishing is disabled. Releases are published by GitHub Actions (.github/workflows/release.yml).\\n\\n');process.exit(1)}\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "fast-xml-parser": "^5.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "changelogen": "^0.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
